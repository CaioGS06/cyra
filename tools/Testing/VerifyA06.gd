extends SceneTree
var checks: Array = []
func ck(ok, name):
 checks.append({"passed": bool(ok), "description": name})
 print(("PASS " if ok else "FAIL ") + name)
func ticks(n=2):
 for i in n:
  await physics_frame
  await process_frame
func tap(action, n=1):
 Input.action_press(action)
 await ticks(n)
 Input.action_release(action)
 await ticks(1)
func _initialize():
 call_deferred("run")
func run():
 var room = load("res://Scenes/Test/TestRoomA06.tscn").instantiate()
 root.add_child(room); current_scene=room
 await ticks(5)
 var p=room.get_node("Player")
 var m=p.get_node("Mimicry")
 var session=root.get_node("MimicrySession")
 var a=room.get_node("Enemy")
 var b=room.get_node("EnemyB")
 for e in [a,b]:
  e.set_physics_process(false)
  e.get_node("ContactArea").monitoring=false
 ck(m.get("Enabled"), "A06 habilita mimetismo")
 ck(not session.get("HasA") and not session.get("HasB") and session.get("Active")=="", "processo novo sem aquisicoes")
 ck(not m.call("TrySwitch","habilidade_A_pulo_duplo"),"troca sem aquisicao rejeitada")
 ck(not m.call("TryDash",1,true),"investida ausente rejeitada")
 ck(not m.call("TryExtraJump"),"salto extra ausente rejeitado")
 p.position=Vector2(360,416); a.position=Vector2(420,416)
 ck(not m.call("TryAbsorb"),"alvo vivo rejeitado")
 a.call("ReceiveAttack",3)
 p.position=Vector2(140,416)
 ck(not m.call("TryAbsorb"),"alvo distante rejeitado")
 p.position=Vector2(360,416)
 ck(m.call("TryAbsorb"),"absorver A atordoado")
 ck(not m.call("TrySwitch","habilidade_A_pulo_duplo"),"troca durante absorcao rejeitada")
 ck(not m.call("TryAbsorb"),"repeticao durante absorcao rejeitada")
 await ticks(20)
 ck(session.get("HasA") and session.get("Active")=="habilidade_A_pulo_duplo", "A adquirida e equipada")
 ck(a.get("IsAbsorbed") and not a.visible,"alvo removido da disponibilidade")
 ck(not m.call("TryAbsorb"),"alvo absorvido rejeitado")
 ck(not a.call("ReceiveAttack",1),"absorvido nao recebe dano")
 await tap("player_jump",3)
 ck(p.velocity.y<0,"pulo basico com A")
 await tap("player_jump",2)
 ck(m.get("ExtraUsed") and p.velocity.y<0,"segundo pressionamento executa adicional")
 var v=p.velocity.y
 await tap("player_jump",3)
 ck(p.velocity.y>v,"terceiro salto rejeitado")
 await ticks(80)
 ck(p.is_on_floor() and not m.get("ExtraUsed"),"pouso restaura adicional")
 # morte com A; health fixture real signal, reload real
 p.get_node("Health").call("ApplyDamage",99,"fixture")
 ck(not m.call("TryAbsorb"),"jogador morto rejeitado")
 await ticks(6)
 room=current_scene;p=room.get_node("Player");m=p.get_node("Mimicry");a=room.get_node("Enemy");b=room.get_node("EnemyB")
 ck(session.get("HasA") and session.get("Active")=="habilidade_A_pulo_duplo" and p.get_node("Health").get("Current")==5,"morte com A preserva aquisicao/ativa e restaura vida")
 ck(not a.get("IsStunned") and not b.get("IsStunned"),"morte reinicia ambos inimigos")
 for e in [a,b]:
  e.set_physics_process(false);e.get_node("ContactArea").monitoring=false
 p.position=Vector2(700,416); b.position=Vector2(760,416);b.call("ReceiveAttack",3)
 await tap("player_absorb",20)
 ck(session.get("HasB") and session.get("Active")=="habilidade_B_investida","B adquirida e equipada via input E")
 ck(m.call("TrySwitch","habilidade_A_pulo_duplo"),"troca valida para A")
 await tap("player_jump",4); await tap("player_jump",2)
 ck(m.get("ExtraUsed"),"consome adicional antes de troca")
 m.call("TrySwitch","habilidade_B_investida");m.call("TrySwitch","habilidade_A_pulo_duplo")
 ck(not m.call("TryExtraJump"),"A B A nao recupera adicional")
 m.call("TrySwitch","habilidade_B_investida")
 ck(m.call("TryDash",-1,false),"investida aerea permitida")
 ck(not m.call("TrySwitch","habilidade_A_pulo_duplo"),"troca durante investida rejeitada")
 ck(m.get("AirDashUsed"),"investida consome uso aereo")
 await ticks(15)
 ck(m.call("TrySwitch","habilidade_A_pulo_duplo"),"troca apos investida aceita")
 m.call("TrySwitch","habilidade_B_investida")
 ck(not m.call("TryDash",1,false),"B A B nao restaura investida")
 await ticks(90)
 ck(not m.get("AirDashUsed"),"pouso restaura uso aereo")
 p.position=Vector2(880,416);await ticks(3)
 ck(m.call("TryDash",1,true),"investida solo")
 await ticks(13)
 ck(p.position.x<=904.5,"investida respeita parede")
 ck(not m.call("TryDash",1,true),"intervalo solo respeitado")
 await ticks(35)
 ck(m.call("TryDash",-1,true),"solo permite repetir apos intervalo")
 await ticks(20)
 await tap("player_attack",1)
 ck(not m.call("TrySwitch","habilidade_A_pulo_duplo"),"troca durante ataque rejeitada")
 await ticks(20)
 # reabsorcao A reiniciado com B ativa, vida reduzida e uso extra gasto por fixture
 p.position=Vector2(360,416);a.position=Vector2(420,416);a.call("ReceiveAttack",3)
 p.get_node("Health").call("ApplyDamage",1,"fixture")
 m.call("TrySwitch","habilidade_A_pulo_duplo");m.call("TryExtraJump");m.call("TrySwitch","habilidade_B_investida")
 ck(m.call("TryAbsorb"),"reabsorver A reiniciado")
 await ticks(20)
 ck(session.get("Active")=="habilidade_B_investida" and p.get_node("Health").get("Current")==4 and m.get("ExtraUsed"),"reabsorcao nao equipa/cura/renova usos")
 ck(p.get_node("FormLabel").text.begins_with("B |"),"indicador segue estado B")
 ck(p.get_node("Visual").color.b>0.9,"cor tecnica B sincronizada")
 p.get_node("Health").call("ApplyDamage",99,"fixture")
 await ticks(6)
 room=current_scene;p=room.get_node("Player");m=p.get_node("Mimicry")
 ck(session.get("HasA") and session.get("HasB") and session.get("Active")=="habilidade_B_investida","morte com B preserva ambas e ativa")
 ck(not m.get("ExtraUsed") and not m.get("AirDashUsed") and p.get_node("Health").get("Current")==5,"retorno restaura vida/usos")
 # Comandos simultaneos e consumo sem recuperacao por troca (fixtures isolam altura).
 for e in [room.get_node("Enemy"),room.get_node("EnemyB")]:
  e.set_physics_process(false);e.get_node("ContactArea").monitoring=false
 m.call("TrySwitch","habilidade_A_pulo_duplo")
 Input.action_press("player_attack");Input.action_press("player_form_b")
 await ticks(1)
 Input.action_release("player_attack");Input.action_release("player_form_b")
 await ticks(20)
 ck(session.get("Active")=="habilidade_A_pulo_duplo","J + 2 rejeita troca e nao a enfileira")
 await tap("player_jump",12)
 var held_v=p.velocity.y
 Input.action_press("player_jump")
 await ticks(2)
 ck(m.get("ExtraUsed"),"novo pressionamento consome extra")
 await ticks(8)
 ck(p.velocity.y>held_v-150,"segurar nao repete impulso adicional")
 Input.action_release("player_jump")
 await ticks(90)
 m.call("TrySwitch","habilidade_B_investida")
 p.position=Vector2(300,-400);p.velocity=Vector2.ZERO
 await ticks(3)
 ck(m.call("TryDash",1,false),"investida no ar em fixture alta")
 await ticks(42)
 m.call("TrySwitch","habilidade_A_pulo_duplo");m.call("TrySwitch","habilidade_B_investida")
 ck(not m.call("TryDash",1,false) and not p.is_on_floor(),"uso aereo continua gasto apos intervalo e troca")
 await ticks(100)
 m.call("TrySwitch","habilidade_A_pulo_duplo")
 p.get_node("Health").call("ApplyDamage",99,"fixture_both_active_a")
 await ticks(6)
 room=current_scene;p=room.get_node("Player");m=p.get_node("Mimicry")
 ck(session.get("HasB") and session.get("Active")=="habilidade_A_pulo_duplo","morte com ambas adquiridas e A ativa preserva estado")
 ck(room.get_node("CanvasLayer/MimicryStatus").text.begins_with("A |"),"HUD fixo sincronizado no retorno")
 # Empate de candidatos e reconfirmacao do alcance ao concluir.
 for e in [room.get_node("Enemy"),room.get_node("EnemyB")]:
  e.set_physics_process(false);e.get_node("ContactArea").monitoring=false;e.position=Vector2(800,416)
 p.position=Vector2(300,416)
 var candidates=[]
 for id in ["fixture_z","fixture_a"]:
  var e=load("res://Scenes/Entities/BasicEnemy.tscn").instantiate()
  e.set("TechnicalId",id);e.set("AbilityId","habilidade_A_pulo_duplo");e.position=Vector2(360,416)
  room.add_child(e);e.set_physics_process(false);e.get_node("ContactArea").monitoring=false;e.call("ReceiveAttack",3);candidates.append(e)
 ck(m.call("TryAbsorb"),"dois candidatos elegiveis iniciam absorcao")
 await ticks(20)
 ck(candidates[1].get("IsAbsorbed") and not candidates[0].get("IsAbsorbed"),"empate por ID ordinal escolhe fixture_a")
 ck(m.call("TryAbsorb"),"candidato restante selecionado")
 p.position=Vector2(140,416)
 await ticks(20)
 ck(not candidates[0].get("IsAbsorbed"),"afastar durante absorcao rejeita conclusao")
 m.call("TrySwitch","habilidade_B_investida")
 ck(not m.call("TryExtraJump"),"B ativa nao concede salto adicional")
 ck(m.call("TryDash",1,true),"investida para verificar dano normal")
 var hp=p.get_node("Health").get("Current")
 ck(p.call("TryReceiveDamage",1,"fixture_contact_dash") and p.get_node("Health").get("Current")==hp-1,"investida nao concede invulnerabilidade")
 await ticks(20)
 for e in candidates:e.queue_free()
 # R native event
 var key=InputEventKey.new();key.keycode=KEY_R;key.physical_keycode=KEY_R;key.pressed=true;Input.parse_input_event(key)
 await ticks(6)
 ck(current_scene!=room and session.get("HasA") and session.get("HasB"),"R reinicia mundo preservando aquisicoes")
 var marker=InputEventKey.new();marker.keycode=KEY_F9;marker.pressed=true;Input.parse_input_event(marker)
 await ticks(4)
 var failed=checks.filter(func(c):return not c.passed).size()
 var report={"passed":checks.size()-failed,"failed":failed,"checks":checks,"simulated_input":true,"fixtures":true,"headless":true,"human_review":"pending"}
 var out=FileAccess.open("res://.godot/a06/results.json",FileAccess.WRITE);out.store_string(JSON.stringify(report,"  "));out.close()
 quit(0 if failed==0 else 1)
